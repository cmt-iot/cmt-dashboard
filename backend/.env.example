# Port the Go backend listens on. Default: 8080
PORT=8080

# "true" runs the built-in simulator instead of expecting real ESP32/MQTT data. Default: true
SIMULATE=true

# Full mysql connection string , expected for local dev
# my sql use port 3308 for local dev.
DB_DSN=root:yourpassword@tcp(localhost:3308)/cmt?parseTime=true